{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": ".generator-build",
    "rootDir": ".",
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/features/static-site-generator/**/*.ts",
    "src/features/static-site-generator/**/*.tsx"
  ]
}
