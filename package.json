{
  "name": "nextbuilder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:site": "tsc -p tsconfig.generator.json && node --env-file=.env .generator-build/scripts/seed-site.js",
